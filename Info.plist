<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Jorvik Daily News</string>
    <key>CFBundleDisplayName</key>
    <string>Jorvik Daily News</string>
    <key>CFBundleIdentifier</key>
    <string>cc.jorviksoftware.JorvikDailyNews</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleExecutable</key>
    <string>JorvikDailyNews</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- App Transport Security, and why it is set this way.

         NSAllowsArbitraryLoads is ON because a feed reader has to fetch what
         people are subscribed to, and a great deal of RSS is still served over
         plain http. Measured on a real subscription list: 178 of 247 feed URLs
         begin http://. Refusing those would not make the app safer, it would
         make it useless, and the feed itself is treated as hostile input
         regardless of how it arrived.

         NSAllowsArbitraryLoadsInWebContent is OFF, which is the part that
         matters. Web views run the page's own scripts, and over cleartext an
         on-path attacker can rewrite that page — script execution inside the
         app's chrome, with no address bar to check. The cost is small and was
         measured too: of 898 stored article links, 6 are plain http, so this
         affects roughly one live-page fallback in 150. Extraction is
         unaffected, because its first and usual route is URLSession rather
         than a web view. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <false/>
    </dict>
    <key>SUFeedURL</key>
    <string>https://jorviksoftware.cc/appcasts/jorvikdailynews.xml</string>
    <key>SUPublicEDKey</key>
    <string>zVc7rs8EiLmlDAYpgaIItjnHtsCkvyVVub+I0/sSb3Q=</string>
    <!-- Required for a SANDBOXED app: Sparkle installs through its bundled
         Installer.xpc rather than in-process. Without this an update check
         succeeds and the install silently does nothing. The matching
         mach-lookup names are in JorvikDailyNews.entitlements. -->
    <key>SUEnableInstallerLauncherService</key>
    <true/>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
